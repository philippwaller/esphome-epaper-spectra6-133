{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enablePreCommit"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "after 6:00am and before 7:00am on monday"
  ],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "rangeStrategy": "in-range-only"
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "dependencyDashboardAutoclose": true,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Preserve the supported runtime dependency ranges validated by the ESPHome compatibility matrix",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements.txt"
      ],
      "rangeStrategy": "in-range-only"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-dev.txt"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group non-breaking GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchJsonata": [
        "isBreaking != true"
      ],
      "groupName": "GitHub Actions (non-major)",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group non-breaking pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchJsonata": [
        "isBreaking != true"
      ],
      "groupName": "pre-commit hooks (non-major)",
      "groupSlug": "pre-commit-hooks"
    },
    {
      "description": "Group non-breaking Python development dependency updates",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-dev.txt"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchJsonata": [
        "isBreaking != true"
      ],
      "groupName": "Python development dependencies (non-major)",
      "groupSlug": "python-development"
    },
    {
      "description": "Keep release automation updates isolated",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "googleapis/release-please-action"
      ],
      "groupName": null
    }
  ]
}
